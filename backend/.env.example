# Jal-Dharani Backend Environment Configuration

# Database Connection (PostgreSQL with PostGIS)
# Connects to your existing local container 'jal-dharani-db':
DATABASE_URL=postgresql+psycopg://jal_user:jal_password@localhost:5432/jal_dharani

# JWT Authentication Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Google Gemini API Key for AI explanation services
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AWS / LocalStack Configuration (for future SAM / S3 photo storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localhost:4566
